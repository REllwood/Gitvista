{
  "name": "gitvista",
  "version": "0.1.0",
  "private": true,
  "description": "A visual Git client that previews each action on your commit history before it runs.",
  "author": "GitVista",
  "license": "MIT",
  "homepage": "https://github.com/REllwood/gitvista",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/REllwood/gitvista.git"
  },
  "scripts": {
    "dev": "concurrently -k -n VITE,APP -c green,cyan \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:127.0.0.1:5173 && cross-env NODE_ENV=development electron .",
    "test": "node --test tests/unit/*.test.js tests/unit/*.test.cjs tests/integration/*.test.cjs",
    "test:unit": "node --test tests/unit/*.test.js tests/unit/*.test.cjs",
    "test:integration": "node --test tests/integration/*.test.cjs",
    "check:electron": "node --check electron/main.cjs && node --check electron/preload.cjs && node --check electron/git.cjs && node --check electron/github.cjs && node --check electron/rebase-editor.cjs",
    "check:release": "node check-release.cjs",
    "check": "npm run test && npm run check:electron && npm run build",
    "build": "vite build",
    "preview": "vite build && electron .",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder",
    "dist:dir": "vite build && electron-builder --dir",
    "release": "npm run check:release && vite build && electron-builder --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "simple-git": "^4.0.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.15.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^8.2.1",
    "wait-on": "^9.1.0"
  },
  "overrides": {
    "js-yaml": "4.3.2"
  },
  "build": {
    "appId": "com.gitvista.app",
    "productName": "GitVista",
    "copyright": "Copyright © 2026 GitVista",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github"
      }
    ],
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "zip", "arch": ["arm64", "x64"] }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "notarize": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "sign": false
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "maintainer": "GitVista"
    }
  }
}
